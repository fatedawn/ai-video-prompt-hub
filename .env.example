# videogen：视频模型的密钥都由你自己提供。复制本文件为 .env（已被 .gitignore 忽略，不会进 git）再填写。
# 本仓库不提供、不托管、不上传任何密钥；也可以直接用系统环境变量（优先级高于 .env）。
# 只填你要用的那一家即可；不填也能用 --dry-run 查看请求、或走路线 C（网页端手动，零密钥）。

# ── 路线 A：云 API（自带 key）──
# 火山方舟 Seedance：https://console.volcengine.com/ark  （模型 ID 或接入点 ep-xxx 填到 SEEDANCE_MODEL）
ARK_API_KEY=
# SEEDANCE_MODEL=doubao-seedance-2-5-260628
# ARK_BASE_URL=https://ark.cn-beijing.volces.com

# 可灵 Kling：https://kling.ai （新版 API Key；国内账号如有不同域名填 KLING_BASE_URL）
KLING_API_KEY=
# KLING_BASE_URL=https://api-singapore.klingai.com
# KLING_MODEL=kling-3.0

# MiniMax 海螺：国际站 https://platform.minimax.io ；国内站把 MINIMAX_BASE_URL 改成 https://api.minimaxi.com
MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://api.minimax.io
# MINIMAX_MODEL=MiniMax-H3

# Google Veo（Gemini API）：https://aistudio.google.com/apikey
GEMINI_API_KEY=
# VEO_MODEL=veo-3.1-generate-preview

# fal.ai：https://fal.ai/dashboard/keys
FAL_KEY=
# FAL_MODEL=fal-ai/wan/v2.2-a14b/text-to-video
# FAL_MODEL_I2V=fal-ai/wan/v2.2-a14b/image-to-video

# Replicate：https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# REPLICATE_MODEL=wan-video/wan-2.2-t2v-fast
# REPLICATE_MODEL_I2V=wan-video/wan-2.2-i2v-fast

# Runway：https://dev.runwayml.com
RUNWAYML_API_SECRET=
# RUNWAY_MODEL=gen4.5

# Luma：https://lumalabs.ai/api/keys
LUMA_API_KEY=
# LUMA_MODEL=ray-2

# ── 路线 B：自己的 GPU（ComfyUI，不需要 key）──
# COMFYUI_URL=http://127.0.0.1:8188

# ── 本地 TTS（默认配音，不需要 key）──
# HDA_MODELS=~/.cache/hda-models      模型下载/缓存目录
# HDA_PYTHON=animator/.venv/bin/python
