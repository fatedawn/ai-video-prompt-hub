{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "handdrawn-animator/character.schema.json",
  "title": "handdrawn-animator 角色定义（character.json）",
  "type": "object",
  "required": ["type"],
  "properties": {
    "$schema": {"type": "string"},
    "id": {"type": "string"}, "name": {"type": "string", "description": "字幕说话人标签显示的名字"},
    "description": {"type": "string"}, "prompt": {"type": "string", "description": "外观描述（英文/中文），用于 AI 生图时保持角色一致"},
    "color": {"type": "string", "description": "说话人标签颜色"},
    "voice": {"type": "object", "description": "配音音色。local=默认本地开源 TTS（如 kokoro:zm_052 / kokoro:zf_001 / melo）；edge=可选在线 edge-tts 音色；variants=同一角色的多种音色/语气，台词行用 voice: \"激动\" 选择", "properties": {"local": {"type": "string", "pattern": "^(kokoro|melo|aishell3)(:[A-Za-z0-9_]+)?$"}, "edge": {"type": "string", "description": "edge-tts 音色，如 zh-CN-XiaoyiNeural"}, "speed": {"type": "number", "minimum": 0.5, "maximum": 2}, "variants": {"type": "object", "additionalProperties": {"type": "object", "properties": {"local": {"type": "string"}, "edge": {"type": "string"}, "speed": {"type": "number"}}}}}},
    "type": {"enum": ["rig", "image"], "description": "rig = SVG 部件骨架（可走路/挥手/点头/对口型/换表情）；image = PNG/SVG 图片或设定图（整体动作 + 换图）"},
    "height": {"type": "number", "description": "默认在画面中的像素高度"},
    "media": {"type": "string", "description": "可选：角色单独用的画材（默认跟随工程）"},
    "rig": {
      "type": "object", "required": ["svg"],
      "properties": {
        "svg": {"type": "string"},
        "anchor": {"type": "array", "items": {"type": "number"}, "description": "脚底点（SVG 坐标），角色的 x,y 指的就是这里"},
        "parts": {"type": "object", "description": "部件 id → {parent, pivot:[x,y], raise:±1}。部件就是 SVG 里同 id 的 <g>，pivot 是旋转关节点", "additionalProperties": {"type": "object", "properties": {"parent": {"type": ["string", "null"]}, "pivot": {"type": "array", "items": {"type": "number"}}, "raise": {"enum": [1, -1]}, "idle": {"type": "object", "description": "部件自带的待机动作（如漂浮的伙伴）：{bob, sway, period}", "properties": {"bob": {"type": "number"}, "sway": {"type": "number"}, "period": {"type": "number"}}}, "upright": {"type": "number", "description": "手持道具保持竖直的程度 0–1（按父部件角度反向补偿）"}}}},
        "layers": {"type": "object", "properties": {"eyes": {"type": "string"}, "blink": {"type": "string"}, "mouthClosed": {"type": "string"}, "mouthOpen": {"type": "string"}}}
      }
    },
    "expressions": {"type": "object", "description": "表情名 → {eyes, mouth, extra, show[]}（rig），或 表情名 → 图片/设定图格子名（image）", "additionalProperties": {}},
    "poseLayers": {"type": "object", "description": "道具/特效图层（id 以 prop_ 或 fx_ 开头）：default 为平时显示的图层，其余键为动作名，该动作进行时换成这组图层，如 {\"default\": [\"prop_fan_closed\"], \"reveal\": [\"prop_fan_open\", \"fx_reveal\"]}", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
    "actionDefaults": {"type": "object", "description": "该角色各动作的默认参数，如宽袖角色挥手角度小一些：{\"wave\": {\"angle\": 95}}", "additionalProperties": {"type": "object"}},
    "sheet": {"type": "object", "description": "设定图（sheet 命令）额外的姿势格", "properties": {"poses": {"type": "array", "items": {"type": "object", "properties": {"name": {"type": "string"}, "label": {"type": "string"}, "expr": {"type": "string"}, "actions": {"type": "array"}}}}}},
    "palette": {"type": "object", "description": "配色说明（仅文档用途）"},
    "license": {"type": "string"},
    "points": {"type": "object", "description": "挂点（道具跟手）：名字 → {part, at:[x,y]}", "additionalProperties": {"type": "object", "properties": {"part": {"type": "string"}, "at": {"type": "array", "items": {"type": "number"}}}}},
    "image": {
      "type": "object",
      "properties": {
        "views": {"type": "object", "description": "front/side… → 文件路径或设定图格子名"},
        "expressions": {"type": "object"},
        "mouth": {"type": "object", "properties": {"open": {"type": "string"}}},
        "actions": {"type": "object", "description": "动作名（wave/point/jump…）→ 设定图格子名；动作进行期间整格替换成这张姿势图", "additionalProperties": {"type": "string"}},
        "blink": {"type": "string"},
        "sheet": {"type": "object", "properties": {"src": {"type": "string"}, "frames": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4}}}},
        "anchor": {"type": "array", "items": {"type": "number"}, "description": "脚底点，按图片宽高比例 [0.5, 1] = 底边中点"}
      }
    }
  }
}
