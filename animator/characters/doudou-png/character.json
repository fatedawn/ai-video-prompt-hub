      "frames": {"normal": [0, 90, 420, 500], "happy": [420, 90, 420, 500], "surprised": [840, 90, 420, 500], "talk": [1260, 90, 420, 500], "wave": [0, 650, 420, 500]}
    },
    "anchor": [0.5, 0.98],
    "views": {"front": "normal"},
    "expressions": {"happy": "happy", "surprised": "surprised"},
    "mouth": {"open": "talk"},
    "actions": {"wave": "wave"}
